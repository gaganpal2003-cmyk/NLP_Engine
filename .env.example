# =====================================================================
# NLP ENGINE CONFIGURATION
# =====================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=*

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# You can provide a direct SQLAlchemy URI, OR specify individual fields below.
#
# Examples of DATABASE_URL:
# MySQL:        mysql+pymysql://root:password@localhost:3306/frs_db
# PostgreSQL:   postgresql+psycopg2://postgres:password@localhost:5432/frs_db
# SQLite:       sqlite:///./data/detections.db (will auto-create sample if omitted)
#
DATABASE_URL=sqlite:///./data/detections.db

# Optional discrete parameters (used if DATABASE_URL is not set):
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=detection_db

# Query Safety Limits
MAX_ROW_LIMIT=100
QUERY_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------
# LLM (AI Model) Configuration
# ---------------------------------------------------------------------
# Compatible with OpenAI, Google Gemini (OpenAI compat), Ollama (Local), DeepSeek, Groq
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# If using Ollama locally:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3:8b
# LLM_API_KEY=ollama

# If using Google Gemini (via OpenAI compatibility):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------
# API Key & Multi-Tenant Authentication
# ---------------------------------------------------------------------
# Admin key to generate and manage client API keys via /api/admin/keys
ADMIN_API_KEY=cairo_admin_secret_key

# Default client key for quick-start integration
DEFAULT_CLIENT_API_KEY=cairo_nlp_default

# Set to True to enforce X-API-Key header verification
REQUIRE_API_KEY=True
